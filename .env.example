# ── Base (all profiles) ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
LOG_LEVEL=info

# Optional shared rate-limit store (recommended in production with several instances).
# Without it, an in-memory limiter is used. Set both or neither.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Module: email (only when features.email = true) ─────────────────
# EMAIL_PROVIDER=resend        # or "console" to print emails (development only; refused in production)
# EMAIL_API_KEY=               # Resend API key (required when EMAIL_PROVIDER=resend)
# EMAIL_FROM="Minh Starter <noreply@yourdomain.com>"
# CONTACT_TO_EMAIL=            # receives contact form messages

# ── Profile "app" only ───────────────────────────────────────────────
# DATABASE_URL=postgres://postgres:postgres@localhost:54329/minh   # docker compose db
# BETTER_AUTH_SECRET=          # openssl rand -base64 32
# Optional Google sign-in (set both):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
