# ── Base (all profiles) ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
LOG_LEVEL=info

# Optional shared rate-limit store (recommended in production with several instances).
# Without it, an in-memory limiter is used. Set both or neither.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Module: email (only when features.email = true) ─────────────────
# EMAIL_PROVIDER=resend        # or "console" to print emails (development only; refused in production)
# EMAIL_API_KEY=               # Resend API key (required when EMAIL_PROVIDER=resend)
# EMAIL_FROM="Minh Starter <noreply@yourdomain.com>"
# CONTACT_TO_EMAIL=            # receives contact form messages

# ── Profile "app" only ───────────────────────────────────────────────
# DATABASE_URL=postgres://postgres:postgres@localhost:54329/minh   # docker compose db
# BETTER_AUTH_SECRET=          # openssl rand -base64 32
# Optional Google sign-in (set both):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Module: jobs (profile app) ───────────────────────────────────────
# CRON_SECRET=                 # Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/jobs/run

# ── Module: billing (providers in config/billing.ts) ─────────────────
# Polar (international subscriptions)
# POLAR_ACCESS_TOKEN=          # organization access token (sandbox and production tokens differ)
# POLAR_WEBHOOK_SECRET=        # whsec_… ; endpoint: https://<domain>/api/billing/webhooks/polar
# POLAR_SERVER=sandbox         # "production" required when NODE_ENV=production
# POLAR_PRODUCT_PRO_MONTHLY=   # Polar product id
# POLAR_PRODUCT_PRO_YEARLY=
# VNPay (Vietnam, one-time payments)
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_PAYMENT_URL=           # default: sandbox; production: https://pay.vnpay.vn/vpcpay.html
#                              # IPN URL to register with VNPay: https://<domain>/api/billing/vnpay/ipn

# ── Module: analytics ────────────────────────────────────────────────
# ANALYTICS_SECRET=            # ≥32 chars (openssl rand -base64 32); keys the daily visitor hash
#                              # profile "site": analytics also needs DATABASE_URL (events only)

# ── Module: storage (S3-compatible; Cloudflare R2 in production) ─────
# Local: pnpm storage:up → http://localhost:58333, keys devaccess / devsecret-local-only (db/docker/s3.json)
# STORAGE_ENDPOINT=            # R2: https://<account-id>.r2.cloudflarestorage.com (also needed at build time: CSP)
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=auto
