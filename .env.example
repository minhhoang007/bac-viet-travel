# ── Base (all profiles) ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
LOG_LEVEL=info

# Optional shared rate-limit store (recommended in production with several instances).
# Without it, an in-memory limiter is used. Set both or neither.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ── Module: email (only when features.email = true) ─────────────────
# EMAIL_FROM="Minh Starter <noreply@yourdomain.com>"
# EMAIL_API_KEY=            # Resend API key
# CONTACT_TO_EMAIL=         # receives contact form messages

# ── Profile "app" only (V0.2) ────────────────────────────────────────
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/minh
# BETTER_AUTH_SECRET=
