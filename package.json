{
  "name": "minh-web-app-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "arch": "depcruise core components config content bootstrap modules providers product app proxy.ts --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm arch && pnpm test",
    "db:up": "docker compose up -d db",
    "db:generate:starter": "drizzle-kit generate --config drizzle.starter.config.ts",
    "db:generate:product": "drizzle-kit generate --config drizzle.product.config.ts",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "test:int": "vitest run --config vitest.integration.config.ts",
    "init:project": "node scripts/init-project.ts",
    "verify:init": "bash scripts/verify-init.sh",
    "test:e2e:app": "bash scripts/e2e-app.sh",
    "admin:grant": "node --env-file-if-exists=.env.local scripts/admin-grant.ts",
    "storage:up": "docker compose up -d storage",
    "launch:check": "node --import ./scripts/ts-alias.mjs scripts/launch-check.ts",
    "setup:check": "node --env-file-if-exists=.env.local --import ./scripts/ts-alias.mjs scripts/setup-check.ts",
    "blog:import": "node --env-file-if-exists=.env.local --import ./scripts/ts-alias.mjs scripts/import-blog.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@aws-sdk/s3-request-presigner": "^3.1145.0",
    "@mdx-js/mdx": "^3.1.1",
    "@polar-sh/sdk": "^1.0.2",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.3",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.50.0",
    "next": "^16.3.8",
    "next-intl": "^4.14.9",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "uqr": "0.1.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dependency-cruiser": "^18.5.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  }
}
